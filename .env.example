# Local server
LIVING_AI_HOST=127.0.0.1
LIVING_AI_PORT=8000
LIVING_AI_DATA_DIR=./data
# Set a strong admin password before any network exposure.
LIVING_AI_ADMIN_PASSWORD=

# Two-model intent:
# Model A = character n-gram fallback; Model B = Gemma 4 E2B LiteRT-LM inference.
# LiteRT-LM is inference-only. Model B fine-tuning/evaluation/conversion is NOT implemented yet.
# Existing n-gram and tiny-Transformer trainers are separate legacy features.
# Allowed: char_ngram | tiny_transformer | litert_lm | hybrid
LIVING_AI_MODEL_BACKEND=hybrid
LIVING_AI_MODEL_PATH=models/char_ngram.json

# Official model: litert-community/gemma-4-E2B-it-litert-lm
# Explicitly opt in to large network operations; both defaults are disabled.
LIVING_AI_AUTO_DOWNLOAD_MODEL=false
LIVING_AI_AUTO_UPDATE=false
LIVING_AI_LITERTLM_REPO=litert-community/gemma-4-E2B-it-litert-lm
LIVING_AI_LITERTLM_FILENAME=gemma-4-E2B-it.litertlm
LIVING_AI_MODEL_MAX_DOWNLOAD_BYTES=5000000000
LIVING_AI_LITERTLM_MODEL_PATH=models/litert/gemma-4-E2B-it.litertlm
# CPU is the safest starting point; GPU/NPU require compatible runtime and hardware.
LIVING_AI_LITERTLM_BACKEND=cpu

# Optional legacy from-scratch byte-level Transformer
LIVING_AI_TINY_MODEL_DIR=models/tiny_transformer
LIVING_AI_TINY_DEVICE=cpu
LIVING_AI_TINY_BLOCK_SIZE=64
LIVING_AI_TINY_D_MODEL=64
LIVING_AI_TINY_HEADS=4
LIVING_AI_TINY_LAYERS=2
LIVING_AI_TINY_DROPOUT=0.1

# Optional remote OpenAI-compatible provider. Keep disabled for local-first operation.
LIVING_AI_ALLOW_REMOTE_PROVIDER=false
LIVING_AI_PROVIDER_URL=
LIVING_AI_PROVIDER_API_KEY=
LIVING_AI_PROVIDER_MODEL=

# Settings evolution promotion remains disabled by default.
LIVING_AI_AUTO_PROMOTE=false
