LIVING_AI_HOST=127.0.0.1
LIVING_AI_PORT=8000
LIVING_AI_DATA_DIR=./data
LIVING_AI_ADMIN_TOKEN=
# char_ngram | tiny_transformer | litert_lm | hybrid
LIVING_AI_MODEL_BACKEND=hybrid
LIVING_AI_MODEL_PATH=models/char_ngram.json
LIVING_AI_LITERTLM_MODEL_PATH=models/litert/model.litertlm
# cpu is the safest starting point; gpu/npu require compatible runtime/hardware
LIVING_AI_LITERTLM_BACKEND=cpu
LIVING_AI_TINY_MODEL_DIR=models/tiny_transformer
LIVING_AI_TINY_DEVICE=cpu
LIVING_AI_TINY_BLOCK_SIZE=64
LIVING_AI_TINY_D_MODEL=64
LIVING_AI_TINY_HEADS=4
LIVING_AI_TINY_LAYERS=2
LIVING_AI_TINY_DROPOUT=0.1
LIVING_AI_ALLOW_REMOTE_PROVIDER=false
LIVING_AI_PROVIDER_URL=
LIVING_AI_PROVIDER_API_KEY=
LIVING_AI_PROVIDER_MODEL=
LIVING_AI_AUTO_PROMOTE=false
